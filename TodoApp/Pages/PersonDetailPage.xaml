<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TodoApp.Pages.PersonDetailPage"
             Title="{Binding PageTitle}">

       <ScrollView>
              <VerticalStackLayout Padding="20"
                                   Spacing="12">

                     <Label Text="Voornaam *"/>
                     <Entry Text="{Binding FirstName}"/>

                     <Label Text="Achternaam"/>
                     <Entry Text="{Binding LastName}"/>

                     <Label Text="Geboortedatum"/>
                     <DatePicker Date="{Binding BirthDate}"/>

                     <Label Text="Afbeelding URL"/>
                     <Entry Text="{Binding ImageUrl}"/>

                     <Image Source="{Binding ImageUrl}"
                            HeightRequest="160"
                            Aspect="AspectFit"/>

                     <Label Text="{Binding ErrorMessage}"
                            TextColor="Red"/>

                     <Button Text="Opslaan"
                             Command="{Binding SaveCommand}"/>

                     <Button Text="Verwijderen"
                             Command="{Binding DeleteCommand}"
                             IsVisible="{Binding IsExistingPerson}"/>

                     <Button Text="Annuleren"
                             Command="{Binding CancelCommand}"/>

              </VerticalStackLayout>
       </ScrollView>
</ContentPage>